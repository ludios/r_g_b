{
	"name": "r_g_b",
	"private": true,
	"version": "0.0.1",
	"description": "a WebGL feedback loop that grows stripes from three dots",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "vitest run"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.15.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@logtape/logtape": "^2.3.5",
		"ayy": "^4.1.0",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/three": "^0.186.0",
		"fast-check": "^4.9.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.11"
	}
}
